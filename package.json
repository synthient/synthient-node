{
  "name": "@synthient/synthient",
  "version": "2.0.0",
  "description": "The official Node.js client for the Synthient API.",
  "keywords": [
    "synthient",
    "ip intelligence",
    "proxy detection",
    "vpn detection",
    "threat intelligence"
  ],
  "homepage": "https://synthient.com",
  "bugs": "https://github.com/synthient/synthient-node/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synthient/synthient-node.git"
  },
  "license": "Apache-2.0",
  "author": "Synthient",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./grpcschema": {
      "types": "./dist/grpcschema.d.ts",
      "default": "./dist/grpcschema.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test \"test/*.test.ts\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check:package": "sh scripts/check-package.sh",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@grpc/grpc-js": "^1.10.0"
  },
  "peerDependenciesMeta": {
    "@bufbuild/protobuf": {
      "optional": true
    },
    "@grpc/grpc-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@bufbuild/protobuf": "^2.16.0",
    "@eslint/js": "^10.0.1",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@grpc/reflection": "^1.0.4",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
